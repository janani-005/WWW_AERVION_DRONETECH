/**
 * AERVION DRONETECH SOLUTIONS PVT. LTD.
 * Google Apps Script (Code.gs) for Google Sheets Contact & Quote Form Submission
 * 
 * Instructions:
 * 1. Open Google Sheets (https://sheets.new)
 * 2. Click on "Extensions" > "Apps Script"
 * 3. Delete any default code in Code.gs and paste this entire file content.
 * 4. Save the project (Ctrl+S or disk icon).
 * 5. Click "Deploy" > "New deployment".
 * 6. Click gear icon next to "Select type" > choose "Web app".
 * 7. Set Description: "Aervion Contact Form Web App"
 * 8. Set Execute as: "Me (your google account)"
 * 9. Set Who has access: "Anyone"  <-- CRITICAL FOR FORM SUBMISSIONS
 * 10. Click "Deploy", authorize permissions when prompted.
 * 11. Copy the Web App URL (starts with https://script.google.com/macros/s/.../exec)
 * 12. Paste the Web App URL into js/contact.js inside the GOOGLE_SCRIPT_URL variable.
 */

// Configuration Options
var SHEET_NAME = "Quote Requests";
var ADMIN_EMAIL = "Info@aerviondronetechsolutions.in"; // Change to your email for instant email notifications

function doPost(e) {
  var lock = LockService.getScriptLock();
  // Wait up to 10 seconds for concurrent submissions to prevent line overwrites
  lock.tryLock(10000);

  try {
    var doc = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = doc.getSheetByName(SHEET_NAME);

    // Create tab if it does not exist
    if (!sheet) {
      sheet = doc.insertSheet(SHEET_NAME);
    }

    // Auto-create styled header row if sheet is empty
    if (sheet.getLastRow() === 0) {
      var headers = [
        "Timestamp",
        "Full Name / Organization",
        "Email Address",
        "Phone Number",
        "Service Required",
        "Project Overview & Location"
      ];
      sheet.appendRow(headers);
      var headerRange = sheet.getRange(1, 1, 1, headers.length);
      headerRange.setFontWeight("bold");
      headerRange.setBackground("#22c55e"); // Aervion Accent Green
      headerRange.setFontColor("#ffffff");
      sheet.setFrozenRows(1);
    }

    // Parse incoming request data (handles JSON payload or form parameter payload)
    var data = {};
    if (e && e.postData && e.postData.contents) {
      try {
        data = JSON.parse(e.postData.contents);
      } catch (err) {
        data = e.parameter;
      }
    } else if (e && e.parameter) {
      data = e.parameter;
    }

    // Format submission values
    var timestamp = new Date().toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
    var fullName = data.fullName || data["Full Name"] || "N/A";
    var email = data.email || data["Email"] || "N/A";
    var phone = data.phone || data["Phone"] || "N/A";
    var serviceType = data.serviceType || data["Service Required"] || "N/A";
    var message = data.message || data["Message"] || "N/A";

    // Append submission row to sheet
    sheet.appendRow([
      timestamp,
      fullName,
      email,
      phone,
      serviceType,
      message
    ]);

    // Optional: Send automated Email Alert to corporate inbox
    if (ADMIN_EMAIL && ADMIN_EMAIL.trim() !== "") {
      var emailSubject = "⚡ New Drone Service Quote Request - " + fullName;
      var emailBody = "New Quote Request Received on Website\n\n" +
                      "--------------------------------------------------\n" +
                      "Full Name / Org: " + fullName + "\n" +
                      "Email Address:   " + email + "\n" +
                      "Phone Number:    " + phone + "\n" +
                      "Service Type:    " + serviceType + "\n" +
                      "Project Details: " + message + "\n" +
                      "Submission Time: " + timestamp + "\n" +
                      "--------------------------------------------------\n\n" +
                      "This message was automatically generated by Aervion DroneTech Website.";
      try {
        MailApp.sendEmail(ADMIN_EMAIL, emailSubject, emailBody);
      } catch (emailErr) {
        Logger.log("Email Notification Error: " + emailErr.toString());
      }
    }

    // Return JSON Success Response
    return ContentService
      .createTextOutput(JSON.stringify({ "status": "success", "message": "Quote request recorded successfully." }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    Logger.log("doPost Error: " + error.toString());
    return ContentService
      .createTextOutput(JSON.stringify({ "status": "error", "message": error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);

  } finally {
    lock.releaseLock();
  }
}

function doGet(e) {
  return ContentService
    .createTextOutput(JSON.stringify({
      "status": "active",
      "app": "Aervion DroneTech Solutions Google Sheets API Endpoint",
      "timestamp": new Date().toISOString()
    }))
    .setMimeType(ContentService.MimeType.JSON);
}
